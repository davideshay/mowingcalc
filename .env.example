# Home Assistant
HA_URL=https://hassist.shaytech.net
HA_TOKEN=your_long_lived_access_token_here

# Application
APP_PORT=3000
APP_TIMEZONE=America/New_York
APP_LOG_LEVEL=info

# Database (SQLite)
DB_PATH=/data/mowingcalc.db

# Algorithm (can also be set via /api/config)
ALGORITHM_RUN_INTERVAL_MINUTES=15
WEATHER_CACHE_TTL_MINUTES=30

# Note: Entity groups (sensors, mower, etc.) are stored in the database
# and configured via the web UI at /api/config. They do not belong in
# environment variables — they are per-deployment user settings.
